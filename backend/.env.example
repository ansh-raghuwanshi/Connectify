# Server Configuration
PORT=3000
NODE_ENV=development

# MongoDB Atlas Configuration
# Note: DB_NAME specifies the intended database name ('connectify')
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xmtdm72.mongodb.net/?appName=Cluster0
DB_NAME=connectify

# JWT Authentication Secrets
ACCESS_TOKEN_SECRET=your_super_secret_access_token_key_here
ACCESS_TOKEN_EXPIRY=15m
REFRESH_TOKEN_SECRET=your_super_secret_refresh_token_key_here
REFRESH_TOKEN_EXPIRY=7d

# CORS & Client Application
CORS_ORIGIN=http://localhost:5173
FRONTEND_URL=http://localhost:5173

# Brevo Transactional Email Configuration
# IMPORTANT:
# - For BREVO_API_KEY, use the REST API key starting with 'xkeysib-'
#   Obtain from: Brevo Dashboard > SMTP & API > API Keys > Generate a new API key.
# - Do NOT use an 'xsmtpsib-' SMTP key as the API key.
BREVO_API_KEY=xkeysib-your_brevo_api_key_here
EMAIL_FROM=Connectify
# EMAIL_USER must be a verified sender in Brevo Dashboard > Senders & IP > Senders
EMAIL_USER=your_verified_sender@example.com

# AI Service (FastAPI Microservice)
AI_SERVICE_URL=http://127.0.0.1:8000
